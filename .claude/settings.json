{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "defaultMode": "default",
    "deny": [
      "Read(/data/internal/**)",
      "Read(/data/firma/**)",
      "Edit(/data/internal/**)",
      "Edit(/data/firma/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/audit_ai/**)",
      "Read(~/audit_ai_internal/**)",
      "Read(//mnt/c/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "./data/internal",
        "./data/firma",
        "~/.config/gh",
        "~/.config/audit_ai",
        "~/audit_ai_internal",
        "/mnt/c"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Glob|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_profile_data.sh",
            "args": [],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
