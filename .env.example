# [inti] Nama variabel saja; secret tidak pernah ditulis di sini (ROADMAP v2.3 §4 F0).
# Pakai: cp .env.example .env  lalu isi nilainya di .env (file .env tidak ikut di-commit).
# Di repo publik hanya variabel inti + profil public.

# Profil aktif: public | internal (biasanya di-export di terminal sebelum source scripts/load_secrets.sh)
AUDIT_AI_PROFILE=

# Tracing LangSmith wajib mati (ROADMAP §8)
LANGSMITH_TRACING=false

# Rute LLM profil public lewat LiteLLM (dipakai mulai F1/F3)
ANTHROPIC_API_KEY=
